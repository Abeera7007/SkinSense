<resources>
    <style name="Theme.SkinSenseAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rose</item>
        <item name="colorPrimaryVariant">@color/roseDark</item>
        <item name="colorSecondary">@color/roseDark</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/ivory</item>
        <item name="android:navigationBarColor">@color/ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/ivory</item>
    </style>

    <style name="FeatureButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/espresso</item>
        <item name="strokeColor">@color/sand</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/cardCream</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>
